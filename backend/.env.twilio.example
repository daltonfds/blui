# ============================================================
# BLUI — TWILIO
# Configurar estes valores no Render.
# NÃO colocar segredos no Git.
# ============================================================

# Twilio Account
TWILIO_ACCOUNT_SID=

# Twilio API Key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# SMS
# Exemplo: +1XXXXXXXXXX
TWILIO_SMS_FROM=

# WhatsApp
# Exemplo: whatsapp:+14155238886
# ou o número WhatsApp aprovado da tua conta.
TWILIO_WHATSAPP_FROM=

# Opcional — URL pública do backend BLUI
# Útil para configurar os webhooks no Twilio.
BLUI_BACKEND_URL=https://blui-backend.onrender.com
